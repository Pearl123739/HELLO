        <button class="icon-btn" onclick="openCart()" aria-label="Shopping bag">🛍️<span class="cart-count" id="cartCount">0</span></button>
      </div>
    </nav>
  </header>

  <main>
    <section class="hero">
      <div class="hero-copy">
        <div>
          <div class="eyebrow">Anti-Tarnish Jewellery · Made for You</div>
          <h1>Jewellery<br><em>that feels like you.</em></h1>
