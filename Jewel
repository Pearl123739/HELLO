<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Pearlhush — anti-tarnish jewellery that feels like you. Discover everyday chains, bracelets, rings, earrings and more." />
  <title>Pearlhush | Jewellery That Feels Like You</title>
  <style>
    :root{
      --ink:#2b2025;
      --muted:#74656c;
      --rose:#c9859d;
      --rose-dark:#a85f7b;
      --blush:#f8edf1;
      --cream:#fffaf7;
      --white:#fff;
      --line:#eadde2;
      --gold:#c9a56a;
      --shadow:0 18px 50px rgba(75,39,53,.10);
      --radius:22px;
    }
    *{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth}
    body{font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--ink);background:var(--cream);line-height:1.6}
    img{width:100%;display:block;object-fit:cover}
    button,a{font:inherit}
    a{text-decoration:none;color:inherit}
    .announcement{background:var(--ink);color:#fff;text-align:center;font-size:12px;letter-spacing:.12em;text-transform:uppercase;padding:9px 16px}
    header{position:sticky;top:0;z-index:50;background:rgba(255,250,247,.94);backdrop-filter:blur(16px);border-bottom:1px solid rgba(234,221,226,.7)}
    .nav{max-width:1200px;margin:auto;height:76px;display:flex;align-items:center;justify-content:space-between;padding:0 22px}
    .logo{font-family:Georgia,serif;font-size:30px;letter-spacing:.08em}
    .logo span{color:var(--rose-dark)}
    .navlinks{display:flex;gap:30px;font-size:14px}
    .navlinks a:hover{color:var(--rose-dark)}
    .icons{display:flex;align-items:center;gap:12px}
    .icon-btn{border:0;background:transparent;cursor:pointer;width:42px;height:42px;border-radius:50%;display:grid;place-items:center;font-size:20px}
    .icon-btn:hover{background:var(--blush)}
    .cart-count{font-size:10px;background:var(--rose-dark);color:white;border-radius:99px;padding:2px 6px;position:absolute;margin: -25px 0 0 18px}
    .menu-btn{display:none}
    .hero{min-height:650px;display:grid;grid-template-columns:1.02fr .98fr;background:linear-gradient(135deg,#fff8f5,#f6e7ed)}
    .hero-copy{display:flex;align-items:center;padding:80px clamp(24px,7vw,90px)}
    .eyebrow{font-size:12px;letter-spacing:.22em;text-transform:uppercase;color:var(--rose-dark);font-weight:700;margin-bottom:18px}
    h1{font-family:Georgia,serif;font-weight:400;font-size:clamp(50px,7vw,88px);line-height:.98;letter-spacing:-.04em;margin-bottom:24px}
    .hero-copy p{max-width:520px;color:var(--muted);font-size:17px;margin-bottom:30px}
    .btn{display:inline-flex;align-items:center;justify-content:center;border:1px solid var(--ink);padding:13px 24px;border-radius:999px;cursor:pointer;transition:.2s}
    .btn-dark{background:var(--ink);color:white}
    .btn-dark:hover{background:#49353e;transform:translateY(-2px)}
    .btn-light{background:white;margin-left:8px}
    .hero-photo{min-height:650px;background:
      linear-gradient(180deg,rgba(43,32,37,.02),rgba(43,32,37,.08)),
      url("https://images.unsplash.com/photo-1617038260897-41a1f14a8ca0?auto=format&fit=crop&w=1200&q=85") center/cover}
    .trust{display:grid;grid-template-columns:repeat(4,1fr);max-width:1200px;margin:auto;padding:24px 22px;gap:14px}
    .trust div{padding:18px;background:white;border:1px solid var(--line);border-radius:16px;text-align:center}
    .trust strong{display:block;font-size:14px}
    .trust span{font-size:12px;color:var(--muted)}
    section{padding:82px 22px}
    .section-head{max-width:1200px;margin:0 auto 36px;display:flex;align-items:end;justify-content:space-between;gap:20px}
    .section-head h2{font-family:Georgia,serif;font-weight:400;font-size:42px}
    .section-head p{color:var(--muted);max-width:500px}
    .filters{max-width:1200px;margin:0 auto 30px;display:flex;gap:10px;flex-wrap:wrap}
    .filter{border:1px solid var(--line);background:white;padding:9px 16px;border-radius:999px;cursor:pointer}
    .filter.active,.filter:hover{background:var(--ink);color:white;border-color:var(--ink)}
    .grid{max-width:1200px;margin:auto;display:grid;grid-template-columns:repeat(4,1fr);gap:22px}
    .card{background:white;border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;position:relative;transition:.25s}
    .card:hover{transform:translateY(-5px);box-shadow:var(--shadow)}
    .product-image{aspect-ratio:1/1.05;overflow:hidden;background:#f7eef1}
    .product-image img{height:100%;transition:.5s}
    .card:hover .product-image img{transform:scale(1.04)}
    .badge{position:absolute;top:13px;left:13px;background:white;padding:5px 9px;border-radius:999px;font-size:10px;text-transform:uppercase;letter-spacing:.08em}
    .heart{position:absolute;right:12px;top:10px;border:0;background:white;width:36px;height:36px;border-radius:50%;cursor:pointer;font-size:17px}
    .product-info{padding:18px}
    .category{font-size:10px;text-transform:uppercase;letter-spacing:.14em;color:var(--muted)}
    .product-info h3{font-family:Georgia,serif;font-weight:400;font-size:20px;margin:5px 0}
    .price{font-weight:700}
    .old{color:#a99ca2;text-decoration:line-through;font-size:13px;margin-left:6px;font-weight:400}
    .add{width:100%;border:1px solid var(--ink);background:transparent;padding:10px;border-radius:999px;margin-top:13px;cursor:pointer}
    .add:hover{background:var(--ink);color:#fff}
    .story{background:var(--blush)}
    .story-grid{max-width:1200px;margin:auto;display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:center}
    .story-img{border-radius:30px;overflow:hidden;box-shadow:var(--shadow)}
    .story-copy h2{font:400 46px/1.1 Georgia,serif;margin-bottom:18px}
    .story-copy p{color:var(--muted);margin-bottom:20px}
    .points{display:grid;gap:13px;margin:25px 0}
    .point{display:flex;gap:12px;align-items:center}
    .point b{width:30px;height:30px;border-radius:50%;background:white;display:grid;place-items:center;font-size:13px}
    .banner{max-width:1200px;margin:auto;border-radius:28px;padding:55px;background:var(--ink);color:white;display:flex;align-items:center;justify-content:space-between;gap:30px}
    .banner h2{font:400 42px Georgia,serif}
    .banner p{color:#d8cbd0;margin-top:8px}
    .banner .btn{border-color:white;color:white}
    .reviews{background:white}
    .review-grid{max-width:1200px;margin:auto;display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
    .review{border:1px solid var(--line);border-radius:22px;padding:26px}
    .stars{color:var(--gold);letter-spacing:.12em}
    .review p{margin:15px 0;color:var(--muted)}
    .review strong{font-size:13px}
    .insta-grid{max-width:1200px;margin:auto;display:grid;grid-template-columns:repeat(5,1fr);gap:10px}
    .insta-grid div{aspect-ratio:1;border-radius:16px;overflow:hidden}
    footer{background:#21181c;color:white;padding:65px 22px 25px}
    .footer-grid{max-width:1200px;margin:auto;display:grid;grid-template-columns:1.5fr 1fr 1fr 1.2fr;gap:40px}
    footer .logo{margin-bottom:14px}
    footer p,footer a{color:#cbbfc4;font-size:13px}
    footer h4{margin-bottom:15px}
    footer ul{list-style:none;display:grid;gap:8px}
    .newsletter{display:flex;margin-top:12px}
    .newsletter input{min-width:0;flex:1;padding:12px 14px;border:0;border-radius:999px 0 0 999px}
    .newsletter button{border:0;background:var(--rose);color:white;padding:0 18px;border-radius:0 999px 999px 0;cursor:pointer}
    .copyright{max-width:1200px;margin:50px auto 0;padding-top:20px;border-top:1px solid #44383d;color:#9e9196;font-size:12px;display:flex;justify-content:space-between}
    .drawer-overlay{position:fixed;inset:0;background:rgba(20,12,16,.45);z-index:90;opacity:0;pointer-events:none;transition:.25s}
    .drawer{position:fixed;right:-440px;top:0;height:100%;width:min(420px,94vw);background:var(--cream);z-index:100;padding:25px;transition:.3s;box-shadow:-15px 0 50px rgba(0,0,0,.15);display:flex;flex-direction:column}
    .drawer.open{right:0}.drawer-overlay.open{opacity:1;pointer-events:auto}
    .drawer-head{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line);padding-bottom:18px}
    .drawer-head h3{font:400 27px Georgia,serif}
    .cart-items{flex:1;overflow:auto;padding:18px 0}
    .cart-item{display:grid;grid-template-columns:70px 1fr auto;gap:12px;margin-bottom:16px;align-items:center}
    .cart-item img{width:70px;height:70px;border-radius:12px}
    .cart-item h4{font:400 15px Georgia,serif}
    .cart-item small{color:var(--muted)}
    .remove{border:0;background:transparent;cursor:pointer;color:#a55;font-size:12px}
    .cart-total{border-top:1px solid var(--line);padding-top:18px}
    .cart-total div{display:flex;justify-content:space-between;font-weight:700;margin-bottom:15px}
    .empty{text-align:center;color:var(--muted);padding:60px 20px}
    .toast{position:fixed;left:50%;bottom:25px;transform:translate(-50%,20px);background:var(--ink);color:white;padding:12px 20px;border-radius:999px;opacity:0;pointer-events:none;z-index:150;transition:.25s}
    .toast.show{opacity:1;transform:translate(-50%,0)}
    @media(max-width:900px){
      .navlinks{display:none}.menu-btn{display:grid}
      .hero{grid-template-columns:1fr}.hero-copy{padding:70px 24px}.hero-photo{min-height:470px}
      .grid{grid-template-columns:repeat(2,1fr)}
      .trust{grid-template-columns:repeat(2,1fr)}
      .story-grid{grid-template-columns:1fr}.story-copy{order:-1}
      .footer-grid{grid-template-columns:1fr 1fr}.insta-grid{grid-template-columns:repeat(3,1fr)}
    }
    @media(max-width:560px){
      .logo{font-size:24px}.nav{height:66px;padding:0 14px}
      section{padding:60px 15px}.hero-copy{padding:60px 20px}
      h1{font-size:55px}.hero-photo{min-height:400px}
      .trust{padding:15px;gap:8px}.trust div{padding:14px 8px}
      .section-head{display:block}.section-head h2{font-size:36px;margin-bottom:10px}
      .grid{grid-template-columns:1fr 1fr;gap:10px}.product-info{padding:13px}.product-info h3{font-size:17px}
      .banner{display:block;padding:35px 25px}.banner h2{font-size:34px}.banner .btn{margin-top:22px}
      .review-grid{grid-template-columns:1fr}.footer-grid{grid-template-columns:1fr}.insta-grid{grid-template-columns:repeat(2,1fr)}
      .copyright{display:block}.copyright span{display:block;margin-top:7px}
    }
  </style>
</head>
<body>
  <div class="announcement">Free shipping on orders above ₹999 · Anti-tarnish everyday jewellery</div>

  <header>
    <nav class="nav">
      <button class="icon-btn menu-btn" onclick="toggleMenu()" aria-label="Menu">☰</button>
      <a href="#" class="logo">Pearl<span>hush</span></a>
