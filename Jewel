        <p>Real words from girls who found a little Pearlhush magic.</p>
      </div>
      <div class="review-grid">
        <div class="review"><div class="stars">★★★★★</div><p>“The chain is even prettier in person. I've been wearing it almost every day and it still looks so beautiful!”</p><strong>— Ananya · Verified customer</strong></div>
        <div class="review"><div class="stars">★★★★★</div><p>“Packaging was so cute and the jewellery feels premium. Definitely ordering again.”</p><strong>— Meera · Verified customer</strong></div>
        <div class="review"><div class="stars">★★★★★</div><p>“Finally found an everyday piece that matches everything. Pearlhush is now my go-to.”</p><strong>— Diya · Verified customer</strong></div>
      </div>
    </section>

    <section>
      <div class="section-head">
        <div><div class="eyebrow">@pearlhush</div><h2>Seen on you.</h2></div>
        <p>Tag <b>@pearlhush</b> to be featured.</p>
      </div>
      <div class="insta-grid">
        <div><img src="https://images.unsplash.com/photo-1611652022419-a9419f74343d?auto=format&fit=crop&w=600&q=80" alt="Jewellery" loading="lazy"></div>
        <div><img src="https://images.unsplash.com/photo-1599643477877-530eb83abc8e?auto=format&fit=crop&w=600&q=80" alt="Gold jewellery" loading="lazy"></div>
        <div><img src="https://images.unsplash.com/photo-1617038260897-41a1f14a8ca0?auto=format&fit=crop&w=600&q=80" alt="Pearl jewellery" loading="lazy"></div>
        <div><img src="https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?auto=format&fit=crop&w=600&q=80" alt="Earrings" loading="lazy"></div>
        <div><img src="https://images.unsplash.com/photo-1603561591411-07134e71a2a9?auto=format&fit=crop&w=600&q=80" alt="Jewellery styling" loading="lazy"></div>
      </div>
    </section>
  </main>

  <footer id="contact">
    <div class="footer-grid">
      <div>
        <div class="logo">Pearl<span>hush</span></div>
        <p>Jewellery that feels like you.<br>Anti-tarnish pieces for everyday moments.</p>
      </div>
      <div><h4>Shop</h4><ul><li><a href="#shop">Necklaces</a></li><li><a href="#shop">Bracelets</a></li><li><a href="#shop">Earrings</a></li><li><a href="#shop">Rings</a></li></ul></div>
      <div><h4>Help</h4><ul><li><a href="#">Shipping & Delivery</a></li><li><a href="#">Returns</a></li><li><a href="#">Care Guide</a></li><li><a href="#">Contact Us</a></li></ul></div>
      <div><h4>Join the Pearlhush circle</h4><p>Get first access to new drops and little surprises.</p><form class="newsletter" onsubmit="subscribe(event)"><input type="email" placeholder="Your email address" required><button>Join</button></form></div>
    </div>
    <div class="copyright"><span>© 2026 Pearlhush. All rights reserved.</span><span>Jewellery that feels like you. ♡</span></div>
  </footer>

  <div class="drawer-overlay" id="overlay" onclick="closeCart()"></div>
  <aside class="drawer" id="drawer">
    <div class="drawer-head"><h3>Your bag</h3><button class="icon-btn" onclick="closeCart()">✕</button></div>
    <div class="cart-items" id="cartItems"></div>
    <div class="cart-total"><div><span>Total</span><span id="cartTotal">₹0</span></div><button class="btn btn-dark" style="width:100%" onclick="checkout()">Proceed to checkout</button></div>
  </aside>
  <div class="toast" id="toast"></div>

<script>
const products = [
 {id:1,name:"Pearl Glow Chain",cat:"necklaces",price:799,old:999,img:"https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?auto=format&fit=crop&w=800&q=85",badge:"Bestseller"},
 {id:2,name:"Butterfly Bloom Chain",cat:"necklaces",price:749,old:899,img:"https://images.unsplash.com/photo-1617038220319-276d3cfab638?auto=format&fit=crop&w=800&q=85",badge:"New"},
 {id:3,name:"Tulip Love Bracelet",cat:"bracelets",price:699,old:799,img:"https://images.unsplash.com/photo-1619119069152-a2b331eb392a?auto=format&fit=crop&w=800&q=85",badge:"Bestseller"},
 {id:4,name:"Dainty Heart Earrings",cat:"earrings",price:599,old:699,img:"https://images.unsplash.com/photo-1635767798638-3e25273a8236?auto=format&fit=crop&w=800&q=85",badge:""},
 {id:5,name:"Pearl Drop Hoops",cat:"earrings",price:649,old:749,img:"https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?auto=format&fit=crop&w=800&q=85",badge:"New"},
 {id:6,name:"Everyday Shine Ring",cat:"rings",price:449,old:549,img:"https://images.unsplash.com/photo-1605100804763-247f67b3557e?auto=format&fit=crop&w=800&q=85",badge:""},
 {id:7,name:"Butterfly Charm Anklet",cat:"anklets",price:699,old:799,img:"https://images.unsplash.com/photo-1573408301185-9146fe634ad0?auto=format&fit=crop&w=800&q=85",badge:""},
 {id:8,name:"Rose Cuff Bangle",cat:"bracelets",price:799,old:949,img:"https://images.unsplash.com/photo-1573408301185-9146fe634ad0?auto=format&fit=crop&w=800&q=85",badge:"Trending"}
];
let cart = JSON.parse(localStorage.getItem("pearlhush-cart") || "[]");

function renderProducts(filter="all"){
 const grid=document.getElementById("productGrid");
 const list=filter==="all"?products:products.filter(p=>p.cat===filter);
 grid.innerHTML=list.map(p=>`
  <article class="card">
   ${p.badge?`<span class="badge">${p.badge}</span>`:""}
   <button class="heart" onclick="this.textContent=this.textContent==='♡'?'♥':'♡'">♡</button>
   <div class="product-image"><img src="${p.img}" alt="${p.name}" loading="lazy"></div>
   <div class="product-info">
    <span class="category">${p.cat}</span><h3>${p.name}</h3>
    <span class="price">₹${p.price.toLocaleString('en-IN')} <span class="old">₹${p.old.toLocaleString('en-IN')}</span></span>
    <button class="add" onclick="addToCart(${p.id})">Add to bag</button>
   </div>
  </article>`).join("");
}
function filterProducts(filter,btn){
 document.querySelectorAll(".filter").forEach(b=>b.classList.remove("active"));
 btn.classList.add("active"); renderProducts(filter);
}
function addToCart(id){
 const item=products.find(p=>p.id===id);
 const existing=cart.find(x=>x.id===id);
 existing?existing.qty++:cart.push({...item,qty:1});
 saveCart(); showToast(item.name+" added to your bag"); openCart();
}
function saveCart(){localStorage.setItem("pearlhush-cart",JSON.stringify(cart));updateCart()}
function updateCart(){
 document.getElementById("cartCount").textContent=cart.reduce((s,i)=>s+i.qty,0);
 const box=document.getElementById("cartItems");
 if(!cart.length){box.innerHTML='<div class="empty">Your bag is waiting for a little sparkle ✨</div>';}
 else box.innerHTML=cart.map(i=>`<div class="cart-item"><img src="${i.img}" alt="${i.name}"><div><h4>${i.name}</h4><small>₹${i.price.toLocaleString('en-IN')} × ${i.qty}</small></div><button class="remove" onclick="removeItem(${i.id})">Remove</button></div>`).join("");
 document.getElementById("cartTotal").textContent="₹"+cart.reduce((s,i)=>s+i.price*i.qty,0).toLocaleString('en-IN');
}
function removeItem(id){cart=cart.filter(i=>i.id!==id);saveCart()}
function openCart(){document.getElementById("drawer").classList.add("open");document.getElementById("overlay").classList.add("open")}
function closeCart(){document.getElementById("drawer").classList.remove("open");document.getElementById("overlay").classList.remove("open")}
function checkout(){
 if(!cart.length){showToast("Your bag is empty");return}
 showToast("Checkout is ready to connect to your payment/order system.");
}
