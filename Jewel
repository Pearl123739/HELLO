        <button class="filter" onclick="filterProducts('bracelets',this)">Bracelets</button>
        <button class="filter" onclick="filterProducts('earrings',this)">Earrings</button>
        <button class="filter" onclick="filterProducts('rings',this)">Rings</button>
        <button class="filter" onclick="filterProducts('anklets',this)">Anklets</button>
      </div>
      <div class="grid" id="productGrid"></div>
    </section>

    <section class="story" id="story">
      <div class="story-grid">
        <div class="story-img">
          <img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?auto=format&fit=crop&w=1000&q=85" alt="Pearlhush jewellery styling" loading="lazy">
        </div>
        <div class="story-copy">
          <div class="eyebrow">The Pearlhush feeling</div>
          <h2>For the girl who makes every detail her own.</h2>
          <p>Pearlhush was created for jewellery that doesn't just complete an outfit — it becomes part of you. Pieces you reach for on ordinary mornings, special nights, and every beautiful moment in between.</p>
          <div class="points">
            <div class="point"><b>01</b><span>Thoughtfully designed for everyday styling</span></div>
            <div class="point"><b>02</b><span>Anti-tarnish finish for lasting shine</span></div>
            <div class="point"><b>03</b><span>Soft, feminine details with personality</span></div>
          </div>
          <a href="#shop" class="btn btn-dark">Find your piece</a>
        </div>
      </div>
    </section>

    <section>
      <div class="banner">
        <div><div class="eyebrow" style="color:#e9a9bf">Your next favourite piece</div><h2>Little details.<br>Big feeling.</h2><p>Find something that feels a little more like you.</p></div>
        <a class="btn" href="#shop">Explore Pearlhush</a>
      </div>
    </section>

    <section class="reviews" id="reviews">
